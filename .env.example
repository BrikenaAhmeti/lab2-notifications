NODE_ENV=development
PORT=3008

JWT_ACCESS_SECRET=replace-with-auth-service-access-secret
INTERNAL_API_KEY=link_services_between_them
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:5173,http://127.0.0.1:5173
SWAGGER_ENABLED=true

POSTGRES_USER=medsphere
POSTGRES_PASSWORD=medsphere
POSTGRES_DB=medsphere_notifications
POSTGRES_PORT=5434
DATABASE_URL=postgresql://medsphere:medsphere@localhost:5434/medsphere_notifications?schema=public
# Docker service URL:
# DATABASE_URL=postgresql://medsphere:medsphere@postgres:5432/medsphere_notifications?schema=public

REDIS_PASSWORD=medsphere_redis_password
REDIS_PORT=6380
REDIS_URL=redis://:medsphere_redis_password@localhost:6380
# Docker service URL:
# REDIS_URL=redis://:medsphere_redis_password@redis:6379

MONGO_ROOT_USERNAME=medsphere
MONGO_ROOT_PASSWORD=medsphere
MONGO_DATABASE=medsphere_notifications
MONGO_PORT=27018
MONGODB_URL=mongodb://medsphere:medsphere@localhost:27018/medsphere_notifications?authSource=admin
# Docker service URL:
# MONGODB_URL=mongodb://medsphere:medsphere@mongodb:27017/medsphere_notifications?authSource=admin

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASS=smtp-password
SMTP_FROM=notifications@medsphere.local
AUTH_SERVICE_URL=http://localhost:3005
AUTH_SERVICE_URL_DOCKER=http://host.docker.internal:3005
CORE_SERVICE_URL=http://localhost:3007
CORE_SERVICE_URL_DOCKER=http://host.docker.internal:3007
CHAT_UPLOAD_DIR=uploads/chat
CHAT_PUBLIC_BASE_URL=
APPOINTMENT_REMINDER_JOB_ENABLED=true

NOTIFICATION_SERVICE_PORT=3008
